# FlowTest Standalone（Windows 云桌面）配置
FLOWTEST_RUNTIME_PROFILE=standalone
FLOWTEST_ENVIRONMENT=company
FLOWTEST_DATA_DIR=./data
FLOWTEST_FRONTEND_DIST_DIR=./frontend/dist
FLOWTEST_BIND_HOST=127.0.0.1
FLOWTEST_BIND_PORT=8000
FLOWTEST_SECURE_COOKIES=false
FLOWTEST_RATE_LIMIT_ENABLED=true
FLOWTEST_FEATURE_TEAMS_ENABLED=true
FLOWTEST_FEATURE_TEST_ASSETS_ENABLED=true
FLOWTEST_FEATURE_ADVANCED_WORKFLOWS_ENABLED=true
FLOWTEST_FEATURE_DATA_NODES_ENABLED=true
FLOWTEST_FEATURE_CONTRACT_TESTING_ENABLED=true
FLOWTEST_FEATURE_QUALITY_CENTER_ENABLED=true
FLOWTEST_FEATURE_CAPABILITY_SDK_ENABLED=true
FLOWTEST_FEATURE_MULTI_PROTOCOL_ENABLED=true
FLOWTEST_FEATURE_EVENT_PROTOCOLS_ENABLED=true
FLOWTEST_FEATURE_CONTRACT_HUB_ENABLED=true
FLOWTEST_FEATURE_IMPACT_ENGINE_ENABLED=true
FLOWTEST_FEATURE_QUALITY_INTELLIGENCE_ENABLED=true
FLOWTEST_FEATURE_INTEGRATION_FLOW_ENABLED=false
FLOWTEST_FEATURE_OIDC_ENABLED=false
FLOWTEST_FEATURE_AI_ENABLED=false
FLOWTEST_FEATURE_PERFORMANCE_LAB_ENABLED=false
FLOWTEST_FEATURE_ENVIRONMENT_LAB_ENABLED=false
FLOWTEST_FEATURE_RUNNER_FABRIC_ENABLED=false

# start.ps1 首次运行会自动生成密钥；Standalone 初始账号为 admin，密码为 admin。
FLOWTEST_SECRET_KEY=replace-on-first-start
FLOWTEST_BOOTSTRAP_ADMIN_PASSWORD=admin
FLOWTEST_DATA_ENCRYPTION_KEY=replace-on-first-start
