          "maxItems": 500,
          "minItems": 1,
          "title": "Row Indices",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "row_count",
        "row_indices"
      ],
      "title": "DatasetExpectation",
      "type": "object"
    },
