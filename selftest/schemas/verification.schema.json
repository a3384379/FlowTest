          "maxItems": 100,
          "title": "Previous Artifact Ids",
          "type": "array"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "target_origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Target Origin",
          "type": "string"
        },
        "timestamp_precision": {
          "enum": [
            "second",
            "microsecond"
          ],
          "title": "Timestamp Precision",
          "type": "string"
        }
      },
      "required": [
        "content_utf8",
        "size_bytes",
        "sha256",
        "content_type",
        "filename",
        "project_id",
        "created_by_id",
        "previous_artifact_ids",
        "target_origin",
        "timestamp_precision"
      ],
      "title": "CreatedFileExpectation",
      "type": "object"
    },
    "DatasetExpectation": {
      "additionalProperties": false,
