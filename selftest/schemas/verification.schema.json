          "type": "boolean"
        },
        "path": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Path",
          "type": "array"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "workflow_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workflow Fingerprint",
          "type": "string"
        },
        "workflow_id": {
          "format": "uuid",
          "title": "Workflow Id",
          "type": "string"
        },
        "workflow_version": {
          "minimum": 1,
          "title": "Workflow Version",
          "type": "integer"
        },
        "workflow_version_id": {
          "format": "uuid",
          "title": "Workflow Version Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "project_id",
        "workflow_id",
        "workflow_version_id",
        "workflow_version",
        "workflow_fingerprint",
        "api_sources"
      ],
      "title": "SubflowBinding",
      "type": "object"
    },
    "SyntheticArtifactExpectation": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_type": {
          "const": "application/octet-stream",
          "title": "Content Type",
          "type": "string"
        },
        "content_utf8": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Content Utf8",
          "type": "string"
        },
        "filename": {
          "const": "flowtest.bin",
