{
  "$defs": {
    "ApiSource": {
      "additionalProperties": false,
      "properties": {
        "api_definition_id": {
          "format": "uuid",
          "title": "Api Definition Id",
          "type": "string"
        },
        "api_version": {
          "minimum": 1,
          "title": "Api Version",
          "type": "integer"
        },
        "contract_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Fingerprint",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "api_definition_id",
        "api_version",
        "contract_fingerprint"
      ],
      "title": "ApiSource",
      "type": "object"
    },
    "AssertionExpectation": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "$ref": "#/$defs/JsonValue"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue"
        },
        "mode": {
          "const": "value",
          "default": "value",
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "node_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "phase": {
          "default": "main",
          "enum": [
            "main",
            "cleanup"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed",
        "expected",
        "actual",
        "node_id"
      ],
      "title": "AssertionExpectation",
      "type": "object"
    },
    "BinaryFileExpectation": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "const": "application/octet-stream",
          "title": "Content Type",
          "type": "string"
        },
        "content_utf8": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Content Utf8",
          "type": "string"
        },
        "filename": {
          "const": "flowtest.bin",
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "content_utf8",
        "size_bytes",
        "sha256",
        "content_type",
        "filename"
      ],
      "title": "BinaryFileExpectation",
      "type": "object"
    },
    "CreatedFileExpectation": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "const": "application/octet-stream",
          "title": "Content Type",
          "type": "string"
        },
        "content_utf8": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Content Utf8",
          "type": "string"
        },
        "created_by_id": {
          "format": "uuid",
          "title": "Created By Id",
          "type": "string"
