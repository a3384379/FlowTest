{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "incomplete",
            "mismatched"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Verdict": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "verification_status": {
          "enum": [
            "matched",
            "incomplete",
            "mismatched"
          ],
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "verification_status",
        "findings"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_key": {
      "title": "Batch Key",
      "type": "string"
    },
    "claim": {
      "const": "generation_quality_negative_only",
      "default": "generation_quality_negative_only",
      "title": "Claim",
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Verdict"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "trust": {
      "const": "local_untrusted",
      "default": "local_untrusted",
      "title": "Trust",
      "type": "string"
    }
  },
  "required": [
    "batch_key",
    "exit_code",
    "findings",
    "scenarios"
  ],
  "title": "QualityReport",
  "type": "object"
}
