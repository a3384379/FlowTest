{
  "$defs": {
    "ApiSource": {
      "additionalProperties": false,
      "properties": {
        "api_definition_id": {
          "format": "uuid",
          "title": "Api Definition Id",
          "type": "string"
        },
        "api_version": {
          "minimum": 1,
          "title": "Api Version",
          "type": "integer"
        },
        "contract_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Fingerprint",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "api_definition_id",
        "api_version",
        "contract_fingerprint"
      ],
      "title": "ApiSource",
      "type": "object"
    },
    "FixedAsset": {
      "additionalProperties": false,
      "properties": {
        "api_fingerprint": {
          "title": "Api Fingerprint",
          "type": "string"
        },
        "api_id": {
          "format": "uuid",
          "title": "Api Id",
          "type": "string"
        },
        "api_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ApiSource"
          },
          "maxItems": 50,
          "title": "Api Sources",
          "type": "array"
        },
        "api_version": {
          "title": "Api Version",
          "type": "integer"
        },
        "case_fingerprint": {
          "title": "Case Fingerprint",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "title": "Case Version",
          "type": "integer"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "workflow_fingerprint": {
          "title": "Workflow Fingerprint",
          "type": "string"
        },
        "workflow_id": {
          "format": "uuid",
          "title": "Workflow Id",
          "type": "string"
        },
        "workflow_version": {
          "title": "Workflow Version",
          "type": "integer"
        },
        "workflow_version_id": {
          "format": "uuid",
          "title": "Workflow Version Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "api_id",
        "api_version",
        "api_fingerprint",
        "workflow_id",
        "workflow_version_id",
        "workflow_version",
        "workflow_fingerprint",
        "case_id",
        "case_version",
        "case_fingerprint"
      ],
      "title": "FixedAsset",
      "type": "object"
    },
    "FixedInstallation": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/FixedAsset"
          },
          "title": "Assets",
          "type": "array"
        },
        "batch_key": {
          "title": "Batch Key",
          "type": "string"
        },
        "environment_id": {
          "format": "uuid",
          "title": "Environment Id",
          "type": "string"
        },
        "nonce": {
          "title": "Nonce",
          "type": "string"
        },
        "pack_digest": {
          "title": "Pack Digest",
          "type": "string"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "flowtest-fixed-installation-v1",
          "default": "flowtest-fixed-installation-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "service_id": {
          "format": "uuid",
          "title": "Service Id",
          "type": "string"
        },
        "suite_id": {
          "format": "uuid",
          "title": "Suite Id",
          "type": "string"
        },
        "suite_version": {
          "title": "Suite Version",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "environment_id",
        "service_id",
        "batch_key",
        "nonce",
        "pack_digest",
        "assets",
        "suite_id",
        "suite_version",
        "plan_id"
      ],
      "title": "FixedInstallation",
      "type": "object"
    },
    "InitializationEvidence": {
      "additionalProperties": false,
      "properties": {
        "cleanup_status": {
          "enum": [
            "pending",
            "completed"
          ],
          "title": "Cleanup Status",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "http_attempts": {
          "title": "Http Attempts",
          "type": "integer"
        },
        "manifest_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Manifest Digest",
          "type": "string"
        },
        "rejected_attempts": {
          "title": "Rejected Attempts",
          "type": "integer"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/InitializationObservation"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "target_disposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetDisposalReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "manifest_digest",
        "scenarios",
        "http_attempts",
        "rejected_attempts",
        "collected_at",
        "cleanup_status"
      ],
      "title": "InitializationEvidence",
      "type": "object"
    },
    "InitializationManifest": {
      "additionalProperties": false,
      "properties": {
        "acceptance_id": {
          "const": "ST-INIT-003",
          "default": "ST-INIT-003",
          "title": "Acceptance Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "expected_scenarios": {
          "default": [
            "ST-INIT-concurrent",
            "ST-INIT-partial",
            "ST-INIT-unknown"
          ],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Scenarios",
          "type": "array"
        },
        "nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Nonce",
          "type": "string"
        },
        "pack_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pack Digest",
          "type": "string"
        },
        "pack_id": {
          "const": "initialization-boundaries-v1",
          "default": "initialization-boundaries-v1",
          "title": "Pack Id",
          "type": "string"
        },
        "profile": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "project_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "provenance": {
          "const": "local_untrusted",
          "default": "local_untrusted",
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "const": "flowtest-initialization-boundaries-v1",
          "default": "flowtest-initialization-boundaries-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_native_scenarios": {
          "default": [
            "ST-CORE-echo-boundaries"
          ],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Native Scenarios",
          "type": "array"
        },
        "source_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Digest",
          "type": "string"
        },
        "source_pack_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Pack Digest",
          "type": "string"
        },
        "target_container_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Container Id",
          "type": "string"
        },
        "target_image": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Image",
          "type": "string"
        },
        "target_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Volume",
          "type": "string"
        },
        "verification_scope": {
          "const": "diagnostic_subset",
          "default": "diagnostic_subset",
          "title": "Verification Scope",
          "type": "string"
        }
      },
      "required": [
        "pack_digest",
        "source_pack_digest",
        "project_name",
        "nonce",
        "source_digest",
        "profile",
        "target_container_id",
        "target_volume",
        "target_image",
        "created_at",
        "deadline"
      ],
      "title": "InitializationManifest",
      "type": "object"
    },
    "InitializationObservation": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/InstallationInventory"
        },
        "before": {
          "$ref": "#/$defs/InstallationInventory"
        },
        "installation": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixedInstallation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "published_mapping_matches": {
          "title": "Published Mapping Matches",
          "type": "boolean"
        },
        "repeat": {
          "$ref": "#/$defs/InstallationInventory"
        },
        "resumed_installation": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixedInstallation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "unknown_posts_after_restart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Posts After Restart"
        },
        "unknown_posts_before_restart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Posts Before Restart"
        },
        "workers": {
          "items": {
            "$ref": "#/$defs/InstallWorkerReceipt"
          },
          "title": "Workers",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "project_id",
        "before",
        "after",
        "repeat",
        "workers",
        "published_mapping_matches"
      ],
      "title": "InitializationObservation",
      "type": "object"
    },
    "InstallWorkerReceipt": {
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "enum": [
            0,
            2,
            3,
            4
          ],
          "title": "Exit Code",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "normal",
            "hold",
            "partial",
            "unknown"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "exit_code"
      ],
      "title": "InstallWorkerReceipt",
      "type": "object"
    },
    "InstallationInventory": {
      "additionalProperties": false,
      "properties": {
        "api_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Api Ids",
          "type": "array"
        },
        "case_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "default_service_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Default Service Id"
        },
        "environment_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Environment Ids",
          "type": "array"
        },
        "execution_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Execution Ids",
          "type": "array"
        },
        "plan_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Plan Ids",
          "type": "array"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "service_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Service Ids",
          "type": "array"
        },
        "suite_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Suite Ids",
          "type": "array"
        },
        "workflow_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Workflow Ids",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "api_ids",
        "workflow_ids",
        "case_ids",
        "suite_ids",
        "plan_ids",
        "run_ids",
        "execution_ids",
        "environment_ids",
        "service_ids",
        "default_service_id",
        "complete"
      ],
      "title": "InstallationInventory",
      "type": "object"
    },
    "TargetDisposalReceipt": {
      "additionalProperties": false,
      "properties": {
        "binding_nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Binding Nonce",
          "type": "string"
        },
        "containers_absent": {
          "title": "Containers Absent",
          "type": "boolean"
        },
        "networks_absent": {
          "title": "Networks Absent",
          "type": "boolean"
        },
        "project_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "removed_at": {
          "format": "date-time",
          "title": "Removed At",
          "type": "string"
        },
        "target_container_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Container Id",
          "type": "string"
        },
        "target_image": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Image",
          "type": "string"
        },
        "target_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Volume",
          "type": "string"
        },
        "volumes_absent": {
          "title": "Volumes Absent",
          "type": "boolean"
        }
      },
      "required": [
        "project_name",
        "target_container_id",
        "target_volume",
        "target_image",
        "binding_nonce",
        "removed_at",
        "containers_absent",
        "volumes_absent",
        "networks_absent"
      ],
      "title": "TargetDisposalReceipt",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_verdict": {
      "enum": [
        "passed",
        "blocked"
      ],
      "title": "Batch Verdict",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/InitializationEvidence"
    },
    "exit_code": {
      "enum": [
        0,
        2
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "manifest": {
      "$ref": "#/$defs/InitializationManifest"
    },
    "reason_codes": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "manifest",
    "evidence",
    "batch_verdict",
    "exit_code",
    "reason_codes"
  ],
  "title": "InitializationResult",
  "type": "object"
}
