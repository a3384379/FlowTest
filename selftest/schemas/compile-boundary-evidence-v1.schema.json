{
  "$defs": {
    "CompileBoundaryObservation": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/InstallationInventory"
        },
        "before": {
          "$ref": "#/$defs/InstallationInventory"
        },
        "boundary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Result"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/McpCallReceipt"
          },
          "maxItems": 2,
          "title": "Calls",
          "type": "array"
        },
        "catalog_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Catalog Names",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "proposal_ids_after": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Proposal Ids After",
          "type": "array"
        },
        "proposal_ids_before": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Proposal Ids Before",
          "type": "array"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/JsonObject"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonObject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sdk_version": {
          "title": "Sdk Version",
          "type": "string"
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "key",
        "transport",
        "before",
        "after",
        "proposal_ids_before",
        "proposal_ids_after",
        "request",
        "calls",
        "sdk_version",
        "protocol_version",
        "completed_at"
      ],
      "title": "CompileBoundaryObservation",
      "type": "object"
    },
    "DraftBoundaryObservation": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/InstallationInventory"
        },
        "api_id": {
          "format": "uuid",
          "title": "Api Id",
          "type": "string"
        },
        "api_references": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Api References",
          "type": "array"
        },
        "api_version": {
          "const": 1,
          "title": "Api Version",
          "type": "integer"
        },
        "api_versions": {
          "items": {
            "type": "integer"
          },
          "title": "Api Versions",
          "type": "array"
        },
        "applied_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applied At"
        },
        "before": {
          "$ref": "#/$defs/InstallationInventory"
        },
        "call": {
          "$ref": "#/$defs/McpCallReceipt"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "current_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Version"
        },
        "draft_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Digest",
          "type": "string"
        },
        "expected_reviewer_id": {
          "format": "uuid",
          "title": "Expected Reviewer Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "proposal_applied_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proposal Applied Before"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "proposal_ids_after": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Proposal Ids After",
          "type": "array"
        },
        "proposal_ids_before": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Proposal Ids Before",
          "type": "array"
        },
        "proposal_review_after": {
          "title": "Proposal Review After",
          "type": "string"
        },
        "proposal_review_before": {
          "title": "Proposal Review Before",
          "type": "string"
        },
        "proposal_status_after": {
          "title": "Proposal Status After",
          "type": "string"
        },
        "proposal_status_before": {
          "title": "Proposal Status Before",
          "type": "string"
        },
        "proposed": {
          "$ref": "#/$defs/InstallationInventory"
        },
        "proposed_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposed Digest",
          "type": "string"
        },
        "published_version_count": {
          "title": "Published Version Count",
          "type": "integer"
        },
        "review_mode": {
          "const": "ci_fixture",
          "default": "ci_fixture",
          "title": "Review Mode",
          "type": "string"
        },
        "reviewer_id": {
          "format": "uuid",
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewer_is_admin": {
          "const": false,
          "title": "Reviewer Is Admin",
          "type": "boolean"
        },
        "route": {
          "enum": [
            "quick",
            "flow_spec"
          ],
          "title": "Route",
          "type": "string"
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "workflow_id": {
          "format": "uuid",
          "title": "Workflow Id",
          "type": "string"
        },
        "workflow_project_id": {
          "format": "uuid",
          "title": "Workflow Project Id",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "route",
        "project_id",
        "api_id",
        "api_version",
        "proposal_id",
        "proposal_status_before",
        "proposal_review_before",
        "proposal_applied_before",
        "proposal_status_after",
        "proposal_review_after",
        "applied_at",
        "reviewer_id",
        "expected_reviewer_id",
        "reviewer_is_admin",
        "workflow_id",
        "workflow_project_id",
        "current_version",
        "published_version_count",
        "proposed_digest",
        "draft_digest",
        "api_references",
        "api_versions",
        "before",
        "proposed",
        "after",
        "proposal_ids_before",
        "proposal_ids_after",
        "call",
        "completed_at"
      ],
      "title": "DraftBoundaryObservation",
      "type": "object"
    },
    "InstallationInventory": {
      "additionalProperties": false,
      "properties": {
        "api_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Api Ids",
          "type": "array"
        },
        "case_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "default_service_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Default Service Id"
        },
        "environment_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Environment Ids",
          "type": "array"
        },
        "execution_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Execution Ids",
          "type": "array"
        },
        "plan_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Plan Ids",
          "type": "array"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "service_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Service Ids",
          "type": "array"
        },
        "suite_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Suite Ids",
          "type": "array"
        },
        "workflow_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Workflow Ids",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "api_ids",
        "workflow_ids",
        "case_ids",
        "suite_ids",
        "plan_ids",
        "run_ids",
        "execution_ids",
        "environment_ids",
        "service_ids",
        "default_service_id",
        "complete"
      ],
      "title": "InstallationInventory",
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {},
    "McpCallReceipt": {
      "additionalProperties": false,
      "properties": {
        "batch_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Batch Key",
          "type": "string"
        },
        "call_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "catalog_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Digest",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "phase": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Phase",
          "type": "string"
        },
        "protocol_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "sdk_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Sdk Version",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "tool_name": {
          "maxLength": 160,
          "pattern": "^flowtest\\.[a-z_]+$",
          "title": "Tool Name",
          "type": "string"
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "batch_key",
        "scenario_id",
        "phase",
        "tool_name",
        "transport",
        "sdk_version",
        "protocol_version",
        "request_digest",
        "result_digest",
        "catalog_digest",
        "completed_at",
        "success"
      ],
      "title": "McpCallReceipt",
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "business_code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Code"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "is_error": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Error"
        },
        "persisted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persisted"
        },
        "preview": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview"
        },
        "proposal_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "text_marker": {
          "anyOf": [
            {
              "const": "unknown_tool",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Marker"
        },
        "trace_present": {
          "default": false,
          "title": "Trace Present",
          "type": "boolean"
        }
      },
      "required": [
        "result_digest"
      ],
      "title": "Result",
      "type": "object"
    },
    "TargetDisposalReceipt": {
      "additionalProperties": false,
      "properties": {
        "binding_nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Binding Nonce",
          "type": "string"
        },
        "containers_absent": {
          "title": "Containers Absent",
          "type": "boolean"
        },
        "networks_absent": {
          "title": "Networks Absent",
          "type": "boolean"
        },
        "project_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "removed_at": {
          "format": "date-time",
          "title": "Removed At",
          "type": "string"
        },
        "target_container_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Container Id",
          "type": "string"
        },
        "target_image": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Image",
          "type": "string"
        },
        "target_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Volume",
          "type": "string"
        },
        "volumes_absent": {
          "title": "Volumes Absent",
          "type": "boolean"
        }
      },
      "required": [
        "project_name",
        "target_container_id",
        "target_volume",
        "target_image",
        "binding_nonce",
        "removed_at",
        "containers_absent",
        "volumes_absent",
        "networks_absent"
      ],
      "title": "TargetDisposalReceipt",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "disposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetDisposalReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "drafts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DraftBoundaryObservation"
      },
      "maxItems": 4,
      "title": "Drafts",
      "type": "array"
    },
    "http_attempts": {
      "maximum": 500,
      "minimum": 0,
      "title": "Http Attempts",
      "type": "integer"
    },
    "manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/CompileBoundaryObservation"
      },
      "maxItems": 34,
      "title": "Observations",
      "type": "array"
    },
    "rejected_attempts": {
      "minimum": 0,
      "title": "Rejected Attempts",
      "type": "integer"
    },
    "tool_attempts": {
      "maximum": 100,
      "minimum": 0,
      "title": "Tool Attempts",
      "type": "integer"
    }
  },
  "required": [
    "manifest_digest",
    "observations",
    "http_attempts",
    "tool_attempts",
    "rejected_attempts",
    "collected_at"
  ],
  "title": "CompileBoundaryEvidence",
  "type": "object"
}
