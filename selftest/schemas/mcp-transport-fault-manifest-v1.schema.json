{
  "$defs": {
    "FaultGolden": {
      "additionalProperties": false,
      "properties": {
        "business_code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Code"
        },
        "mutation_count": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Mutation Count",
          "type": "integer"
        },
        "rpc_error_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rpc Error Code"
        },
        "sdk_complete": {
          "default": false,
          "title": "Sdk Complete",
          "type": "boolean"
        },
        "server_http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Http Status"
        },
        "server_killed": {
          "default": false,
          "title": "Server Killed",
          "type": "boolean"
        },
        "server_rpc_error": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Rpc Error"
        },
        "text_marker": {
          "anyOf": [
            {
              "const": "invalid_arguments",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Marker"
        },
        "tool_error": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Error"
        },
        "trace_required": {
          "default": false,
          "title": "Trace Required",
          "type": "boolean"
        },
        "transport_error": {
          "anyOf": [
            {
              "const": "remote_protocol_error",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Error"
        }
      },
      "title": "FaultGolden",
      "type": "object"
    },
    "FaultScenario": {
      "additionalProperties": false,
      "properties": {
        "acceptance_id": {
          "enum": [
            "ST-MCP-004",
            "ST-MCP-007",
            "ST-MCP-008"
          ],
          "title": "Acceptance Id",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/FaultGolden"
        },
        "fault": {
          "enum": [
            "bad_json",
            "bad_version",
            "oversized_field",
            "timeout",
            "pipe_break",
            "socket_break",
            "server_crash",
            "unknown_mutation",
            "inactive_account_creator"
          ],
          "title": "Fault",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "variant_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Variant Key",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "acceptance_id",
        "variant_key",
        "transport",
        "fault",
        "expected"
      ],
      "title": "FaultScenario",
      "type": "object"
    },
    "FrozenCall": {
      "additionalProperties": false,
      "properties": {
        "arguments_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Arguments Digest",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "tool_name",
        "arguments_digest"
      ],
      "title": "FrozenCall",
      "type": "object"
    }
  },
  "$id": "https://flowtest.local/selftest/schemas/mcp-transport-fault-manifest-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "batch_key": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Batch Key",
      "type": "string"
    },
    "calls": {
      "items": {
        "$ref": "#/$defs/FrozenCall"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Calls",
      "type": "array"
    },
    "claim": {
      "const": "transport_fault_negative_only",
      "default": "transport_fault_negative_only",
      "title": "Claim",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "inactive_creator_id": {
      "format": "uuid",
      "title": "Inactive Creator Id",
      "type": "string"
    },
    "inactive_machine_id": {
      "format": "uuid",
      "title": "Inactive Machine Id",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Nonce",
      "type": "string"
    },
    "owner_user_id": {
      "format": "uuid",
      "title": "Owner User Id",
      "type": "string"
    },
    "pack_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pack Digest",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/FaultScenario"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "source_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "trust": {
      "const": "local_untrusted",
      "default": "local_untrusted",
      "title": "Trust",
      "type": "string"
    },
    "writer_machine_id": {
      "format": "uuid",
      "title": "Writer Machine Id",
      "type": "string"
    }
  },
  "required": [
    "batch_key",
    "nonce",
    "pack_digest",
    "source_digest",
    "created_at",
    "expires_at",
    "project_id",
    "owner_user_id",
    "writer_machine_id",
    "inactive_creator_id",
    "inactive_machine_id",
    "scenarios",
    "calls"
  ],
  "title": "FaultManifest",
  "type": "object"
}
