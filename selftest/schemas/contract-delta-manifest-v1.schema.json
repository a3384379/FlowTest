        },
        "target_project_id": {
          "format": "uuid",
          "title": "Target Project Id",
          "type": "string"
        },
        "target_service_id": {
          "format": "uuid",
          "title": "Target Service Id",
          "type": "string"
        },
        "target_user_id": {
          "format": "uuid",
          "title": "Target User Id",
          "type": "string"
        },
        "target_viewer_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Viewer Email"
        },
        "target_viewer_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Viewer Id"
        }
