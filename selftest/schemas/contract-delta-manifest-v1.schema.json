      "required": [
        "project_name",
        "target_container_id",
        "target_volume",
        "target_image",
        "binding_nonce"
      ],
      "title": "RequiredDisposal",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_key": {
      "title": "Batch Key",
      "type": "string"
    },
    "binding_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Fingerprint",
      "type": "string"
    },
    "binding_nonce": {
      "title": "Binding Nonce",
      "type": "string"
    },
    "builds": {
      "$ref": "#/$defs/Builds"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "installation": {
      "$ref": "#/$defs/Installation"
    },
    "nonce": {
      "title": "Nonce",
      "type": "string"
    },
    "pack_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pack Digest",
      "type": "string"
    },
    "required_disposal": {
      "$ref": "#/$defs/RequiredDisposal"
    },
    "scope": {
      "$ref": "#/$defs/FixtureBudgetScope"
    }
  },
  "required": [
    "pack_digest",
    "binding_fingerprint",
    "binding_nonce",
    "batch_key",
    "nonce",
    "builds",
    "installation",
    "created_at",
    "expires_at",
    "scope",
    "required_disposal"
  ],
  "title": "DeltaManifest",
  "type": "object"
}
