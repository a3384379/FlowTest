        "binding_nonce",
        "organization_id",
        "project_id",
        "reviewer_id",
        "reviewer_email",
        "mcp_account_id",
        "target_project_id",
        "target_user_id",
        "target_email",
        "fixture_environment_id",
        "target_environment_id",
        "fixture_service_id",
        "target_service_id"
      ],
      "title": "Installation",
      "type": "object"
    },
    "RequiredDisposal": {
      "additionalProperties": false,
      "properties": {
        "binding_nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Binding Nonce",
          "type": "string"
        },
        "project_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "target_container_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Container Id",
          "type": "string"
        },
        "target_image": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Image",
          "type": "string"
        },
        "target_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Volume",
          "type": "string"
