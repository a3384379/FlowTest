{
  "$defs": {
    "Builds": {
      "additionalProperties": false,
      "properties": {
        "fixture": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture",
          "type": "string"
        },
        "runner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runner",
          "type": "string"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "verifier": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "runner",
        "target",
        "fixture",
        "verifier"
      ],
      "title": "Builds",
      "type": "object"
    },
    "FixtureBudgetScope": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "exclusiveMinimum": 0,
          "title": "Expires At",
          "type": "number"
        },
        "limit": {
          "default": 500,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Nonce",
          "type": "string"
        },
        "parent_batch_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Parent Batch Key",
          "type": "string"
        }
      },
      "required": [
        "parent_batch_key",
        "nonce",
        "expires_at"
      ],
      "title": "FixtureBudgetScope",
      "type": "object"
    },
    "Installation": {
      "additionalProperties": false,
      "properties": {
        "binding_nonce": {
          "title": "Binding Nonce",
          "type": "string"
        },
        "capture_viewer_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Viewer Email"
        },
        "capture_viewer_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Viewer Id"
        },
        "denied_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denied Email"
        },
        "denied_user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denied User Id"
        },
        "fixture_environment_id": {
          "format": "uuid",
          "title": "Fixture Environment Id",
          "type": "string"
        },
        "fixture_service_id": {
          "format": "uuid",
          "title": "Fixture Service Id",
          "type": "string"
        },
        "mcp_account_id": {
          "format": "uuid",
          "title": "Mcp Account Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "reused": {
          "default": false,
          "title": "Reused",
          "type": "boolean"
        },
        "reviewer_email": {
          "title": "Reviewer Email",
          "type": "string"
        },
        "reviewer_id": {
          "format": "uuid",
          "title": "Reviewer Id",
          "type": "string"
        },
        "schema_version": {
          "default": "flowtest-selftest-installation-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_email": {
          "title": "Target Email",
          "type": "string"
        },
        "target_environment_id": {
          "format": "uuid",
          "title": "Target Environment Id",
          "type": "string"
        },
