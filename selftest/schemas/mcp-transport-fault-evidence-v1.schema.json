    "DisposalReceipt": {
      "additionalProperties": false,
      "properties": {
        "binding_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Binding Nonce",
          "type": "string"
        },
        "candidate_image_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Candidate Image Digest",
          "type": "string"
        },
        "containers_absent": {
          "const": true,
          "title": "Containers Absent",
          "type": "boolean"
        },
        "networks_absent": {
          "const": true,
          "title": "Networks Absent",
          "type": "boolean"
        },
        "project_name": {
          "pattern": "^flowtest-selftest-[0-9a-f]{12}$",
          "title": "Project Name",
          "type": "string"
        },
        "removed_at": {
          "format": "date-time",
          "title": "Removed At",
          "type": "string"
        },
        "runner_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runner Volume",
          "type": "string"
        },
        "target_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Volume",
          "type": "string"
        },
        "volumes_absent": {
          "const": true,
          "title": "Volumes Absent",
          "type": "boolean"
        }
