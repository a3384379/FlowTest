      "required": [
        "project_name",
        "binding_nonce",
        "runner_volume",
        "target_volume",
        "candidate_image_digest",
        "removed_at",
        "containers_absent",
        "volumes_absent",
        "networks_absent"
      ],
      "title": "DisposalReceipt",
      "type": "object"
    },
    "FaultObservation": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/ProbeSnapshot"
        },
        "before": {
          "$ref": "#/$defs/ProbeSnapshot"
        },
        "catalog_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Fingerprint",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "dispatch": {
          "$ref": "#/$defs/DispatchReceipt"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/FrameReceipt"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Frames",
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/RpcRequest"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Requests",
          "type": "array"
        },
        "responses": {
          "items": {
            "$ref": "#/$defs/RpcResponse"
          },
          "maxItems": 10,
          "title": "Responses",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/FaultResult"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "sdk_version": {
          "const": "2.2.0",
          "title": "Sdk Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "tool_names": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 300,
          "minItems": 1,
          "title": "Tool Names",
          "type": "array"
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "transport",
        "sdk_version",
        "started_at",
        "completed_at",
        "catalog_fingerprint",
        "tool_names",
        "requests",
        "responses",
        "frames",
        "dispatch",
        "result",
        "before",
        "after"
      ],
