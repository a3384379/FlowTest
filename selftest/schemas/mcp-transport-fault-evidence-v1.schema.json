        "nonce",
        "observed_at",
        "request_id",
        "tool_name",
        "arguments_digest",
        "sdk_frame_digest",
        "forwarded_digest",
        "forwarded_bytes",
        "forwarded_count",
        "fault_applied",
        "process_cleanup_complete"
