  "required": [
    "batch_key",
    "nonce",
    "pack_digest",
    "source_digest",
    "manifest_digest",
    "authority_digest",
    "stack",
    "inactive_fixture",
    "scenarios",
    "http_admitted",
    "http_rejected",
    "tools_admitted",
    "tools_rejected",
    "process_cleanup_complete",
    "disposal_receipt",
    "collected_at"
  ],
  "title": "FaultEvidence",
  "type": "object"
}
