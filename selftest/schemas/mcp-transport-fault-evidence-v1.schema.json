        "fixture": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture",
          "type": "string"
        },
        "runner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runner",
          "type": "string"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "verifier": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "runner",
        "target",
        "fixture",
        "verifier"
      ],
      "title": "Builds",
      "type": "object"
    },
    "DispatchReceipt": {
      "additionalProperties": false,
      "properties": {
        "arguments_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Arguments Digest",
          "type": "string"
        },
        "fault_applied": {
          "title": "Fault Applied",
          "type": "boolean"
        },
        "forwarded_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Forwarded Bytes",
          "type": "integer"
        },
        "forwarded_count": {
          "const": 1,
          "title": "Forwarded Count",
          "type": "integer"
        },
        "forwarded_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Forwarded Digest",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Nonce",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "process_cleanup_complete": {
          "title": "Process Cleanup Complete",
          "type": "boolean"
        },
        "proposal_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "removal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessRemovalProof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Request Id"
        },
        "response_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Digest"
        },
        "response_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Id"
        },
        "response_result_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Result Digest"
        },
        "sdk_frame_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sdk Frame Digest",
          "type": "string"
        },
        "server_http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Http Status"
        },
        "server_killed": {
          "default": false,
          "title": "Server Killed",
          "type": "boolean"
