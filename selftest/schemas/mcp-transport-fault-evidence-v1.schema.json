    },
    "http_admitted": {
      "maximum": 500,
      "minimum": 0,
      "title": "Http Admitted",
      "type": "integer"
    },
    "http_rejected": {
      "minimum": 0,
      "title": "Http Rejected",
      "type": "integer"
    },
    "inactive_fixture": {
      "$ref": "#/$defs/InactiveFixture"
    },
    "manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "nonce": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Nonce",
      "type": "string"
    },
    "pack_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pack Digest",
      "type": "string"
    },
    "process_cleanup_complete": {
      "title": "Process Cleanup Complete",
      "type": "boolean"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/FaultObservation"
      },
      "maxItems": 30,
      "title": "Scenarios",
      "type": "array"
    },
    "source_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "stack": {
      "$ref": "#/$defs/StackSnapshot"
    },
    "tools_admitted": {
      "maximum": 100,
      "minimum": 0,
      "title": "Tools Admitted",
      "type": "integer"
    },
    "tools_rejected": {
      "minimum": 0,
      "title": "Tools Rejected",
      "type": "integer"
    },
    "trust": {
      "const": "local_untrusted",
      "default": "local_untrusted",
      "title": "Trust",
      "type": "string"
    }
