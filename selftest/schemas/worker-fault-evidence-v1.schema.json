{
  "$defs": {
    "FixtureBinaryResponse": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "const": "application/octet-stream",
          "title": "Content Type",
          "type": "string"
        },
        "filename": {
          "const": "flowtest.bin",
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "size_bytes",
        "sha256",
        "content_type",
        "filename"
      ],
      "title": "FixtureBinaryResponse",
      "type": "object"
    },
    "FixtureBudgetReceipt": {
      "additionalProperties": false,
      "properties": {
        "admitted_count": {
          "maximum": 500,
          "minimum": 0,
          "title": "Admitted Count",
          "type": "integer"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "number"
        },
        "fixture_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture Digest",
          "type": "string"
        },
        "limit": {
          "default": 500,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Nonce",
          "type": "string"
        },
        "parent_batch_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Parent Batch Key",
          "type": "string"
        },
        "registration_epoch": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Registration Epoch",
          "type": "string"
        },
        "rejected_count": {
          "minimum": 0,
          "title": "Rejected Count",
          "type": "integer"
        }
      },
      "required": [
        "parent_batch_key",
        "nonce",
        "expires_at",
        "admitted_count",
        "rejected_count",
        "fixture_digest",
        "registration_epoch"
      ],
      "title": "FixtureBudgetReceipt",
      "type": "object"
    },
    "FixtureJournal": {
      "additionalProperties": false,
      "properties": {
        "batch_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Batch Key",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureBudgetReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FixtureRequest"
          },
          "maxItems": 10000,
          "title": "Entries",
          "type": "array"
        },
        "epoch_changed": {
          "default": false,
          "title": "Epoch Changed",
          "type": "boolean"
        },
        "expired": {
          "default": false,
          "title": "Expired",
          "type": "boolean"
        },
        "fixture_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture Digest",
          "type": "string"
        },
        "fixture_epoch": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture Epoch",
          "type": "string"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "next_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Sequence"
        },
        "nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Nonce",
          "type": "string"
        },
        "request_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Request Count",
          "type": "integer"
        },
        "scenario_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "batch_key",
        "scenario_id",
        "nonce",
        "fixture_epoch",
        "fixture_digest",
        "request_count"
      ],
      "title": "FixtureJournal",
      "type": "object"
    },
    "FixtureMetrics": {
      "additionalProperties": false,
      "properties": {
        "active_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Active Count",
          "type": "integer"
        },
        "cancelled_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Cancelled Count",
          "type": "integer"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "completed_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Completed Count",
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/FixtureRequestEvent"
          },
          "maxItems": 500,
          "title": "Events",
          "type": "array"
        },
        "failed_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "peak_concurrency": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Peak Concurrency",
          "type": "integer"
        }
      },
      "required": [
        "events",
        "complete",
        "active_count",
        "peak_concurrency",
        "completed_count",
        "cancelled_count",
        "failed_count"
      ],
      "title": "FixtureMetrics",
      "type": "object"
    },
    "FixturePayload": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "branch": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "fixture_epoch": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Epoch"
        },
        "iteration_key": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iteration Key"
        },
        "marker": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "request_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Count"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "title": "FixturePayload",
      "type": "object"
    },
    "FixtureRequest": {
      "additionalProperties": false,
      "properties": {
        "authorization_present": {
          "default": false,
          "title": "Authorization Present",
          "type": "boolean"
        },
        "binary_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureBinaryResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "binary_response": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureBinaryResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cookie_present": {
          "default": false,
          "title": "Cookie Present",
          "type": "boolean"
        },
        "fixture_epoch": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Epoch"
        },
        "marker": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "method": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "received_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Received At"
        },
        "request_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixturePayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_value_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Value Present"
        },
        "response_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixturePayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Response Status",
          "type": "integer"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "synthetic_cookie": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyntheticCookieSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "synthetic_precedence_header": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyntheticHeaderSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sequence",
        "method",
        "path",
        "response_status"
      ],
      "title": "FixtureRequest",
      "type": "object"
    },
    "FixtureRequestEvent": {
      "additionalProperties": false,
      "properties": {
        "active_at_begin": {
          "maximum": 500,
          "minimum": 1,
          "title": "Active At Begin",
          "type": "integer"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "cancelled",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "started_at": {
          "title": "Started At",
          "type": "number"
        }
      },
      "required": [
        "request_id",
        "sequence",
        "started_at",
        "active_at_begin"
      ],
      "title": "FixtureRequestEvent",
      "type": "object"
    },
    "JsonValue": {},
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "passed",
            "failed",
            "cancelled",
            "quarantined"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Digest"
        },
        "trigger": {
          "anyOf": [
            {
              "enum": [
                "manual",
                "ci"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "api_versions": {
          "items": {
            "type": "integer"
          },
          "maxItems": 20,
          "title": "Api Versions",
          "type": "array"
        },
        "environment_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Digest"
        },
        "execution_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Execution Ids",
          "type": "array"
        },
        "item_statuses": {
          "items": {
            "enum": [
              "queued",
              "running",
              "passed",
              "failed",
              "cancelled",
              "quarantined"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Item Statuses",
          "type": "array"
        },
        "run": {
          "$ref": "#/$defs/Operation"
        },
        "snapshot_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Snapshot Digests",
          "type": "array"
        }
      },
      "required": [
        "run",
        "execution_ids",
        "item_statuses",
        "api_versions",
        "snapshot_digests"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "SyntheticCookieSnapshot": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "set",
            "barrier",
            "check"
          ],
          "title": "Stage",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "stage",
        "value"
      ],
      "title": "SyntheticCookieSnapshot",
      "type": "object"
    },
    "SyntheticHeaderSnapshot": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "project",
                "environment",
                "api",
                "case",
                "runtime",
                "node"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "SyntheticHeaderSnapshot",
      "type": "object"
    },
    "TargetDisposalReceipt": {
      "additionalProperties": false,
      "properties": {
        "binding_nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Binding Nonce",
          "type": "string"
        },
        "containers_absent": {
          "title": "Containers Absent",
          "type": "boolean"
        },
        "networks_absent": {
          "title": "Networks Absent",
          "type": "boolean"
        },
        "project_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "removed_at": {
          "format": "date-time",
          "title": "Removed At",
          "type": "string"
        },
        "target_container_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Container Id",
          "type": "string"
        },
        "target_image": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Image",
          "type": "string"
        },
        "target_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Volume",
          "type": "string"
        },
        "volumes_absent": {
          "title": "Volumes Absent",
          "type": "boolean"
        }
      },
      "required": [
        "project_name",
        "target_container_id",
        "target_volume",
        "target_image",
        "binding_nonce",
        "removed_at",
        "containers_absent",
        "volumes_absent",
        "networks_absent"
      ],
      "title": "TargetDisposalReceipt",
      "type": "object"
    },
    "WorkerFaultReceipt": {
      "additionalProperties": false,
      "properties": {
        "actor_processes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkerProcess"
          },
          "maxItems": 2,
          "title": "Actor Processes",
          "type": "array"
        },
        "container_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Container Id",
          "type": "string"
        },
        "duplicate_tasks": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 2,
          "title": "Duplicate Tasks",
          "type": "array"
        },
        "duplicate_tasks_completed": {
          "default": false,
          "title": "Duplicate Tasks Completed",
          "type": "boolean"
        },
        "exact_container_restarted": {
          "default": false,
          "title": "Exact Container Restarted",
          "type": "boolean"
        },
        "killed_signal": {
          "anyOf": [
            {
              "const": 9,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Killed Signal"
        },
        "queued_before_claim": {
          "default": false,
          "title": "Queued Before Claim",
          "type": "boolean"
        }
      },
      "required": [
        "container_id"
      ],
      "title": "WorkerFaultReceipt",
      "type": "object"
    },
    "WorkerObservation": {
      "additionalProperties": false,
      "properties": {
        "fault": {
          "$ref": "#/$defs/WorkerFaultReceipt"
        },
        "journal": {
          "$ref": "#/$defs/FixtureJournal"
        },
        "native": {
          "$ref": "#/$defs/Snapshot"
        },
        "native_error_codes": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 2,
          "title": "Native Error Codes",
          "type": "array"
        },
        "pre_kill_journal": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureJournal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "source_case_id": {
          "format": "uuid",
          "title": "Source Case Id",
          "type": "string"
        },
        "source_workflow_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Workflow Fingerprint",
          "type": "string"
        },
        "source_workflow_id": {
          "format": "uuid",
          "title": "Source Workflow Id",
          "type": "string"
        },
        "variant": {
          "enum": [
            "double_claim",
            "duplicate_delivery",
            "worker_death",
            "recovery"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "variant",
        "run_id",
        "native",
        "native_error_codes",
        "journal",
        "fault",
        "source_case_id",
        "source_workflow_id",
        "source_workflow_fingerprint"
      ],
      "title": "WorkerObservation",
      "type": "object"
    },
    "WorkerProcess": {
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "const": 0,
          "title": "Exit Code",
          "type": "integer"
        },
        "pid": {
          "minimum": 1,
          "title": "Pid",
          "type": "integer"
        },
        "start_ticks": {
          "minimum": 1,
          "title": "Start Ticks",
          "type": "integer"
        }
      },
      "required": [
        "pid",
        "start_ticks",
        "exit_code"
      ],
      "title": "WorkerProcess",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "disposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetDisposalReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/WorkerObservation"
      },
      "maxItems": 4,
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "const": "flowtest-worker-fault-evidence-v1",
      "default": "flowtest-worker-fault-evidence-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "manifest_digest",
    "collected_at",
    "observations"
  ],
  "title": "WorkerEvidence",
  "type": "object"
}
