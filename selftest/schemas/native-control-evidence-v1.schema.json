        },
        "suite_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suite Fingerprint",
          "type": "string"
        },
        "suite_id": {
          "format": "uuid",
          "title": "Suite Id",
          "type": "string"
        },
        "suite_version": {
          "title": "Suite Version",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "suite_id",
        "suite_version",
        "suite_fingerprint",
        "plan_id",
        "cases",
        "frozen_at"
      ],
      "title": "PlanSelection",
      "type": "object"
    },
    "PlanStopReceipt": {
      "additionalProperties": false,
      "properties": {
        "cancel_requested": {
          "default": false,
