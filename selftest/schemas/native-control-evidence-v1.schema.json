        },
        "workflow_version": {
          "minimum": 1,
          "title": "Workflow Version",
          "type": "integer"
        },
        "workflow_version_id": {
          "format": "uuid",
          "title": "Workflow Version Id",
          "type": "string"
        }
      },
      "required": [
