{
  "$defs": {
    "ApiSource": {
      "additionalProperties": false,
      "properties": {
        "api_definition_id": {
          "format": "uuid",
          "title": "Api Definition Id",
          "type": "string"
        },
        "api_version": {
          "minimum": 1,
          "title": "Api Version",
          "type": "integer"
        },
        "contract_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Fingerprint",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "api_definition_id",
        "api_version",
        "contract_fingerprint"
      ],
      "title": "ApiSource",
      "type": "object"
    },
    "AssertionEvidence": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "$ref": "#/$defs/JsonValue"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue"
        },
        "mode": {
          "const": "value",
          "default": "value",
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed",
        "expected",
        "actual"
      ],
      "title": "AssertionEvidence",
      "type": "object"
    },
    "DatasetBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "row_count": {
          "maximum": 500,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "row_count"
      ],
      "title": "DatasetBinding",
      "type": "object"
    },
    "DatasetChildReference": {
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "format": "uuid",
          "title": "Execution Id",
          "type": "string"
        },
        "row_index": {
          "maximum": 499,
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "passed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "row_index",
        "status"
      ],
      "title": "DatasetChildReference",
      "type": "object"
    },
    "DigestAssertionEvidence": {
      "additionalProperties": false,
      "properties": {
        "actual_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Actual Digest",
          "type": "string"
        },
        "expected_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Digest",
          "type": "string"
        },
        "mode": {
          "const": "digest",
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "name",
        "passed",
        "expected_digest",
        "actual_digest"
      ],
      "title": "DigestAssertionEvidence",
      "type": "object"
    },
    "DisposalReceipt": {
      "additionalProperties": false,
      "properties": {
        "binding_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Binding Nonce",
          "type": "string"
        },
        "candidate_image_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Candidate Image Digest",
          "type": "string"
        },
        "containers_absent": {
          "const": true,
          "title": "Containers Absent",
          "type": "boolean"
        },
        "networks_absent": {
          "const": true,
          "title": "Networks Absent",
          "type": "boolean"
        },
        "project_name": {
          "pattern": "^flowtest-selftest-[0-9a-f]{12}$",
          "title": "Project Name",
          "type": "string"
        },
        "removed_at": {
          "format": "date-time",
          "title": "Removed At",
          "type": "string"
        },
        "runner_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runner Volume",
          "type": "string"
        },
        "target_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Volume",
          "type": "string"
        },
        "volumes_absent": {
          "const": true,
          "title": "Volumes Absent",
          "type": "boolean"
        }
      },
      "required": [
        "project_name",
        "binding_nonce",
        "runner_volume",
        "target_volume",
        "candidate_image_digest",
        "removed_at",
        "containers_absent",
        "volumes_absent",
        "networks_absent"
      ],
      "title": "DisposalReceipt",
      "type": "object"
    },
    "ExecutionEvidence": {
      "additionalProperties": false,
      "properties": {
        "api_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ApiSource"
          },
          "maxItems": 500,
          "title": "Api Sources",
          "type": "array"
        },
        "children": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DatasetChildReference"
          },
          "maxItems": 500,
          "title": "Children",
          "type": "array"
        },
        "children_complete": {
          "default": true,
          "title": "Children Complete",
          "type": "boolean"
        },
        "cleanup_status": {
          "anyOf": [
            {
              "enum": [
                "passed",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cleanup Status"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dataset_row_index": {
          "anyOf": [
            {
              "maximum": 499,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Row Index"
        },
        "environment_id": {
          "format": "uuid",
          "title": "Environment Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "main_status": {
          "anyOf": [
            {
              "enum": [
                "passed",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Status"
        },
        "nested_nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NodeEvidence"
          },
          "maxItems": 1000,
          "title": "Nested Nodes",
          "type": "array"
        },
        "nested_nodes_complete": {
          "default": true,
          "title": "Nested Nodes Complete",
          "type": "boolean"
        },
        "nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NodeEvidence"
          },
          "maxItems": 5000,
          "title": "Nodes",
          "type": "array"
        },
        "parent_execution_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Execution Id"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "run_purpose": {
          "default": "standard",
          "enum": [
            "standard",
            "preview"
          ],
          "title": "Run Purpose",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "passed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "subflows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SubflowBinding"
          },
          "maxItems": 100,
          "title": "Subflows",
          "type": "array"
        },
        "subflows_complete": {
          "default": true,
          "title": "Subflows Complete",
          "type": "boolean"
        },
        "workflow_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workflow Fingerprint",
          "type": "string"
        },
        "workflow_id": {
          "format": "uuid",
          "title": "Workflow Id",
          "type": "string"
        },
        "workflow_version_id": {
          "format": "uuid",
          "title": "Workflow Version Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "workflow_id",
        "workflow_version_id",
        "environment_id",
        "status",
        "snapshot_digest",
        "workflow_fingerprint",
        "started_at"
      ],
      "title": "ExecutionEvidence",
      "type": "object"
    },
    "FixtureBinaryResponse": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "const": "application/octet-stream",
          "title": "Content Type",
          "type": "string"
        },
        "filename": {
          "const": "flowtest.bin",
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "size_bytes",
        "sha256",
        "content_type",
        "filename"
      ],
      "title": "FixtureBinaryResponse",
      "type": "object"
    },
    "FixtureBudgetReceipt": {
      "additionalProperties": false,
      "properties": {
        "admitted_count": {
          "maximum": 500,
          "minimum": 0,
          "title": "Admitted Count",
          "type": "integer"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "number"
        },
        "fixture_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture Digest",
          "type": "string"
        },
        "limit": {
          "default": 500,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Nonce",
          "type": "string"
        },
        "parent_batch_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Parent Batch Key",
          "type": "string"
        },
        "registration_epoch": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Registration Epoch",
          "type": "string"
        },
        "rejected_count": {
          "minimum": 0,
          "title": "Rejected Count",
          "type": "integer"
        }
      },
      "required": [
        "parent_batch_key",
        "nonce",
        "expires_at",
        "admitted_count",
        "rejected_count",
        "fixture_digest",
        "registration_epoch"
      ],
      "title": "FixtureBudgetReceipt",
      "type": "object"
    },
    "FixtureJournal": {
      "additionalProperties": false,
      "properties": {
        "batch_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Batch Key",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureBudgetReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FixtureRequest"
          },
          "maxItems": 10000,
          "title": "Entries",
          "type": "array"
        },
        "epoch_changed": {
          "default": false,
          "title": "Epoch Changed",
          "type": "boolean"
        },
        "expired": {
          "default": false,
          "title": "Expired",
          "type": "boolean"
        },
        "fixture_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture Digest",
          "type": "string"
        },
        "fixture_epoch": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture Epoch",
          "type": "string"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "next_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Sequence"
        },
        "nonce": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Nonce",
          "type": "string"
        },
        "request_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Request Count",
          "type": "integer"
        },
        "scenario_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "batch_key",
        "scenario_id",
        "nonce",
        "fixture_epoch",
        "fixture_digest",
        "request_count"
      ],
      "title": "FixtureJournal",
      "type": "object"
    },
    "FixtureMetrics": {
      "additionalProperties": false,
      "properties": {
        "active_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Active Count",
          "type": "integer"
        },
        "cancelled_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Cancelled Count",
          "type": "integer"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "completed_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Completed Count",
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/FixtureRequestEvent"
          },
          "maxItems": 500,
          "title": "Events",
          "type": "array"
        },
        "failed_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "peak_concurrency": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Peak Concurrency",
          "type": "integer"
        }
      },
      "required": [
        "events",
        "complete",
        "active_count",
        "peak_concurrency",
        "completed_count",
        "cancelled_count",
        "failed_count"
      ],
      "title": "FixtureMetrics",
      "type": "object"
    },
    "FixturePayload": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "branch": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "fixture_epoch": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Epoch"
        },
        "iteration_key": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iteration Key"
        },
        "marker": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "request_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Count"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "title": "FixturePayload",
      "type": "object"
    },
    "FixtureRequest": {
      "additionalProperties": false,
      "properties": {
        "authorization_present": {
          "default": false,
          "title": "Authorization Present",
          "type": "boolean"
        },
        "binary_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureBinaryResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "binary_response": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureBinaryResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cookie_present": {
          "default": false,
          "title": "Cookie Present",
          "type": "boolean"
        },
        "fixture_epoch": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Epoch"
        },
        "marker": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "method": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Method",
