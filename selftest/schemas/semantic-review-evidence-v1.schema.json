    "FixtureRequestEvent": {
      "additionalProperties": false,
      "properties": {
        "active_at_begin": {
          "maximum": 500,
          "minimum": 1,
          "title": "Active At Begin",
          "type": "integer"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
