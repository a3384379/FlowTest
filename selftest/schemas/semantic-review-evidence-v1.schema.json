            }
          ],
          "default": null,
          "title": "Received At"
        },
        "request_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixturePayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_value_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
