          ],
          "default": null,
          "title": "Outcome"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "started_at": {
          "title": "Started At",
          "type": "number"
        }
      },
      "required": [
        "request_id",
        "sequence",
        "started_at",
        "active_at_begin"
      ],
      "title": "FixtureRequestEvent",
      "type": "object"
    },
    "JsonValue": {},
    "McpCallReceipt": {
      "additionalProperties": false,
      "properties": {
        "batch_key": {
          "maxLength": 200,
          "minLength": 1,
