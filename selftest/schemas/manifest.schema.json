          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "content_utf8",
        "size_bytes",
        "sha256",
        "content_type",
        "filename"
      ],
      "title": "BinaryFileExpectation",
      "type": "object"
    },
