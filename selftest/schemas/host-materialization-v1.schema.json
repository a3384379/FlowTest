        "operations",
        "source_document_digest",
        "bound_document_digest",
        "source_reused",
        "context",
        "integration_plan",
        "combined_design",
        "combined_design_fingerprint",
        "design_composition",
        "compilation_fingerprint",
        "oracle_bindings",
        "workflow",
        "case",
        "calls",
        "created_resource_name",
        "updated_resource_name",
        "generated_at",
        "frozen_at"
      ],
      "title": "LifecycleAsset",
      "type": "object"
    },
    "McpCallReceipt": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "batch_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Batch Key",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "phase": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Phase",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 160,
          "pattern": "^flowtest\\.[a-z_]+$",
          "title": "Tool Name",
          "type": "string"
        },
        "transport": {
          "enum": ["stdio", "streamable-http"],
          "title": "Transport",
          "type": "string"
        },
        "sdk_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Sdk Version",
          "type": "string"
        },
        "protocol_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^[0-9a-f]{64}$",
