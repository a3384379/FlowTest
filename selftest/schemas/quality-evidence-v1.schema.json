{
  "$defs": {
    "Builds": {
      "additionalProperties": false,
      "properties": {
        "fixture": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fixture",
          "type": "string"
        },
        "runner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runner",
          "type": "string"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "verifier": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "runner",
        "target",
        "fixture",
        "verifier"
      ],
      "title": "Builds",
      "type": "object"
    },
    "CredentialEndpoint": {
      "additionalProperties": false,
      "properties": {
        "environment_id": {
          "format": "uuid",
          "title": "Environment Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "secret_ref_count": {
          "minimum": 0,
          "title": "Secret Ref Count",
          "type": "integer"
        },
        "service_id": {
          "format": "uuid",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "environment_id",
        "service_id",
        "secret_ref_count"
      ],
      "title": "CredentialEndpoint",
      "type": "object"
    },
    "CredentialProjection": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/CredentialEndpoint"
        },
        "metadata_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Digest",
          "type": "string"
        },
        "reference_count": {
          "minimum": 0,
          "title": "Reference Count",
          "type": "integer"
        },
        "result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "sentinel_leaked": {
          "title": "Sentinel Leaked",
          "type": "boolean"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "reference_count",
        "verified",
        "sentinel_leaked",
        "result_digest",
        "metadata_digest",
        "endpoint"
      ],
      "title": "CredentialProjection",
      "type": "object"
    },
    "DisposalReceipt": {
      "additionalProperties": false,
      "properties": {
        "binding_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Binding Nonce",
          "type": "string"
        },
        "candidate_image_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Candidate Image Digest",
          "type": "string"
        },
        "containers_absent": {
          "const": true,
          "title": "Containers Absent",
          "type": "boolean"
        },
        "networks_absent": {
          "const": true,
          "title": "Networks Absent",
          "type": "boolean"
        },
        "project_name": {
          "pattern": "^flowtest-selftest-[0-9a-f]{12}$",
          "title": "Project Name",
          "type": "string"
        },
        "removed_at": {
          "format": "date-time",
          "title": "Removed At",
          "type": "string"
        },
        "runner_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runner Volume",
          "type": "string"
        },
        "target_volume": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Volume",
          "type": "string"
        },
        "volumes_absent": {
          "const": true,
          "title": "Volumes Absent",
          "type": "boolean"
        }
      },
      "required": [
        "project_name",
        "binding_nonce",
        "runner_volume",
        "target_volume",
        "candidate_image_digest",
        "removed_at",
        "containers_absent",
        "volumes_absent",
        "networks_absent"
      ],
      "title": "DisposalReceipt",
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {},
    "McpCallReceipt": {
      "additionalProperties": false,
      "properties": {
        "batch_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Batch Key",
          "type": "string"
        },
        "call_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "catalog_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Digest",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "phase": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Phase",
          "type": "string"
        },
        "protocol_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "sdk_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Sdk Version",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "tool_name": {
          "maxLength": 160,
          "pattern": "^flowtest\\.[a-z_]+$",
          "title": "Tool Name",
          "type": "string"
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "batch_key",
        "scenario_id",
        "phase",
        "tool_name",
        "transport",
        "sdk_version",
        "protocol_version",
        "request_digest",
        "result_digest",
        "catalog_digest",
        "completed_at",
        "success"
      ],
      "title": "McpCallReceipt",
      "type": "object"
    },
    "ProbeDesign": {
      "additionalProperties": false,
      "properties": {
        "document_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Digest",
          "type": "string"
        },
        "intent_key_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Key Digest",
          "type": "string"
        },
        "objective_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Digest",
          "type": "string"
        },
        "oracles": {
