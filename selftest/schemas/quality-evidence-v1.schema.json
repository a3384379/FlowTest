          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "organization_id"
      ],
      "title": "ProbeFixture",
      "type": "object"
    },
    "ProbeItem": {
      "additionalProperties": false,
