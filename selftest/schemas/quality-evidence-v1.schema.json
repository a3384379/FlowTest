    "ProbePage": {
      "additionalProperties": false,
      "properties": {
        "binding_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Fingerprint",
          "type": "string"
        },
        "binding_id": {
          "format": "uuid",
          "title": "Binding Id",
          "type": "string"
        },
        "builds": {
          "$ref": "#/$defs/Builds"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "covered_kinds": {
          "items": {
            "enum": [
              "workflow",
              "workflow_version",
              "test_case",
              "test_case_version",
              "test_plan",
              "test_plan_run",
              "workflow_execution",
              "ai_change_set",
              "test_design",
              "change_set_approval"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 10,
          "title": "Covered Kinds",
          "type": "array"
        },
        "covered_projects": {
          "items": {
            "$ref": "#/$defs/ProbeFixture"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Covered Projects",
          "type": "array"
        },
        "execution_scope": {
          "const": "governance_negative_only",
          "title": "Execution Scope",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "has_more": {
          "title": "Has More",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ProbeResource"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}\\.[0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "probe_id": {
          "format": "uuid",
          "title": "Probe Id",
          "type": "string"
        },
        "provenance": {
          "const": "local_untrusted",
          "title": "Provenance",
          "type": "string"
        },
        "purpose": {
          "const": "mcp_governance_negative",
          "title": "Purpose",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Reason Codes",
          "type": "array"
        },
        "runtime_profile": {
          "enum": [
            "full",
            "compact",
            "compose",
            "standalone"
          ],
          "title": "Runtime Profile",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "probe_id",
        "purpose",
        "execution_scope",
        "provenance",
        "binding_id",
        "binding_fingerprint",
        "manifest_digest",
        "source_digest",
        "runtime_profile",
        "builds",
        "covered_projects",
        "covered_kinds",
        "items",
        "total",
        "next_cursor",
        "has_more",
        "complete",
        "reason_codes",
        "snapshot_digest",
        "observed_at",
        "expires_at"
      ],
      "title": "ProbePage",
      "type": "object"
    },
