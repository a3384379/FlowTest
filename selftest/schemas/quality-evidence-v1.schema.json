              "type": "null"
            }
          ],
          "title": "Materialized Resource Id"
        },
        "materialized_resource_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Materialized Resource Type"
        },
        "proposed_document_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Document Digest"
        },
        "review_status": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Review Status",
          "type": "string"
        },
        "reviewed_by_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewed By Id"
        }
      },
      "required": [
        "id",
        "item_type",
        "action",
        "review_status",
        "reviewed_by_id",
        "materialized_resource_type",
        "materialized_resource_id"
      ],
      "title": "ProbeItem",
      "type": "object"
    },
    "ProbeOracle": {
      "additionalProperties": false,
      "properties": {
        "expected_digest": {
          "pattern": "^[0-9a-f]{64}$",
