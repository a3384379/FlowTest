          "maxItems": 500,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "enum": [
            "workflow",
            "workflow_version",
            "test_case",
            "test_case_version",
            "test_plan",
            "test_plan_run",
            "workflow_execution",
            "ai_change_set",
            "test_design",
            "change_set_approval"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "reviewed_by_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By Id"
        },
        "source_change_set_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Change Set Id"
        },
        "status": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "id",
        "project_id",
        "status"
      ],
      "title": "ProbeResource",
      "type": "object"
    },
    "ProbeSnapshot": {
      "additionalProperties": false,
